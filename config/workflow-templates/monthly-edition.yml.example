# TEMPLATE, NOT ACTIVE. Kept outside .github/workflows on purpose.
# Monthly reference edition: after a window [YYYY-MM-15, next month 15) closes and
# the configured consolidation delay (48 hours) has elapsed, prepare a candidate
# edition for review. A delay of 48 hours does not guarantee completeness: a
# partial source keeps its partial status. Publication is a separate, reviewed,
# manual step; data/latest.json never points to an unreviewed candidate.
name: monthly-edition

on:
  schedule:
    - cron: "17 13 17 * *"   # 17th of each month 13:17 UTC (target, not a guarantee)
  workflow_dispatch:

permissions:
  contents: read

jobs:
  candidate:
    runs-on: [self-hosted, private-acquisition]   # placeholder: private environment only
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.14"
      - name: Prepare the candidate (no publication)
        run: |
          python -I scripts/dwr.py acquire-readonly
          python -I scripts/dwr.py analyze
          python -I scripts/dwr.py render
          python -I scripts/dwr.py verify
          python -I scripts/dwr.py prepare-edition
